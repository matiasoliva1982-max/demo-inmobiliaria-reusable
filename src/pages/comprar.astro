---
import DemoBanner from '../components/DemoBanner.astro';
import Footer from '../components/Footer.astro';
import ListingPage from '../components/ListingPage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Propiedades en venta en Rosario">
  <DemoBanner />
  <SiteHeader />
  <main>
    <ListingPage
      operation="venta"
      title="Propiedades en venta en Rosario"
      intro="Explorá casas, departamentos, locales y terrenos organizados por zona y rango de precio."
    />
  </main>
  <Footer />
</BaseLayout>
